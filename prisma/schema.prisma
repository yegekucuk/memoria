generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessions  Session[]
  tags      Tag[]
  settings  Settings? // Add relation to Settings
}

model Settings {
  id              String   @id @default(cuid())
  excludeWeekends Boolean  @default(false)
  
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id              String   @id @default(cuid())
  startTime       DateTime
  endTime         DateTime?
  durationSeconds Int      @default(0)
  notes           String?  @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  tags            Tag[]

  @@index([userId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  sessions  Session[]

  @@unique([name, userId])
  @@index([userId, name])
}
